# =============================================================================
# Central Yawara — variáveis do aplicativo web (Next.js)
# Copie para .env.local (desenvolvimento) e NUNCA versione o arquivo preenchido.
# Todas as variáveis NEXT_PUBLIC_* ficam visíveis no navegador: a configuração
# do app web do Firebase é pública por natureza. A segurança vem das regras do
# Firestore/Storage, das Cloud Functions e do App Check — não de esconder estes
# valores. Nunca coloque aqui chaves de conta de serviço (service account).
# =============================================================================

# Fonte de dados: "demo" (dados fictícios só no navegador) ou "firebase".
NEXT_PUBLIC_DATA_SOURCE=demo

# Firebase Console → Configurações do projeto → Seus apps → App da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Região das Cloud Functions (deve ser a mesma de functions/src/core/admin.ts).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# App Check com reCAPTCHA Enterprise (chave do site). Vazio = App Check
# desativado no cliente (use apenas em desenvolvimento).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Desenvolvimento local com o Firebase Emulator Suite (npm run emulators).
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
