# =============================================================================
# Central Yawara — variáveis do aplicativo web (Next.js)
# Copie para .env.local (desenvolvimento) e NUNCA versione o arquivo preenchido.
# Todas as variáveis NEXT_PUBLIC_* ficam visíveis no navegador: a configuração
# do app web do Firebase é pública por natureza. A segurança vem das regras do
# Firestore/Storage, das Cloud Functions e do App Check — não de esconder estes
# valores. Nunca coloque aqui chaves de conta de serviço (service account).
# =============================================================================

# Fonte de dados: "demo" (dados fictícios só no navegador) ou "firebase".
NEXT_PUBLIC_DATA_SOURCE=demo

# Onde rodam as operações do servidor no modo "firebase":
#   route     = rota de API do próprio aplicativo (implantação gratuita, Firebase Spark)
#   functions = Cloud Functions (exige o plano Blaze)
NEXT_PUBLIC_API_TRANSPORT=route

# Arquivos: "links" (gratuito: links do Google Drive/OneDrive), "database" (gratuito: arquivos
# de até 8 MB guardados no próprio Firestore) ou "storage" (Cloud Storage, plano Blaze).
# Use o mesmo valor em FILE_STORAGE (servidor).
NEXT_PUBLIC_FILE_STORAGE=links

# Firebase Console → Configurações do projeto → Seus apps → App da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Só com Cloud Storage (plano Blaze); pode ficar vazio na implantação gratuita.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Região das Cloud Functions (deve ser a mesma de functions/src/core/admin.ts).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# App Check com reCAPTCHA Enterprise (chave do site). Vazio = App Check
# desativado no cliente (use apenas em desenvolvimento).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Desenvolvimento local com o Firebase Emulator Suite (npm run emulators).
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# =============================================================================
# SOMENTE SERVIDOR (implantação gratuita: rota de API do aplicativo)
# Sem prefixo NEXT_PUBLIC_: nunca chegam ao navegador. Preencha no painel da
# hospedagem (ex.: Vercel → Settings → Environment Variables), nunca em
# arquivo versionado. Ver docs/backend/implantacao-gratuita.md.
# =============================================================================
# Da chave da conta de serviço (Configurações do projeto → Contas de serviço).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# "links" ou "database" quando não há Cloud Storage (plano gratuito); igual a NEXT_PUBLIC_FILE_STORAGE.
FILE_STORAGE=links
# Endereço público do aplicativo (usado nos links de convite).
APP_BASE_URL=
# "true" para exigir App Check nas operações do servidor (opcional).
ENFORCE_APP_CHECK=false
