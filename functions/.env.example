# =============================================================================
# Parâmetros das Cloud Functions. Copie para functions/.env.<id-do-projeto>
# (ex.: functions/.env.central-yawara-prod). Não coloque segredos aqui.
# =============================================================================

# Endereço público do aplicativo, usado para montar o link dos convites.
APP_BASE_URL=https://central.exemplo.org

# Exigir App Check nas funções chamáveis (true em produção, depois de
# configurar o reCAPTCHA Enterprise e registrar o app no App Check).
ENFORCE_APP_CHECK=false

# Validade dos convites, em dias.
INVITE_TTL_DAYS=7

# Retenção dos registros de auditoria, em dias (exige a política de TTL do
# campo auditLogs.expireAt ativada no Firestore). 1825 = 5 anos.
AUDIT_RETENTION_DAYS=1825
