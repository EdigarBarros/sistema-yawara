{
  "name": "central-yawara",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  },
  "description": "Central Yawara — plataforma interna da Atlética Yawara de Psicologia (Next.js + Firebase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:firebase": "next dev",
    "emulators": "firebase emulators:start --project demo-yawara",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore,auth,storage --project demo-yawara \"npm --prefix functions test\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-yawara \"vitest run --config vitest.rules.config.mts\"",
    "test:all": "npm test && npm run test:rules && npm run test:functions",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
